<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Un azul muy clarito o un gris más oscuro para que lo veas -->
    <solid android:color="#E0E6ED" />

    <!-- Bordes redondeados más fuertes -->
    <corners android:radius="16dp" />

    <!-- Opcional: Un borde finito para que se note el límite -->
