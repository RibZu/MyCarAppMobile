<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formulario de Alquiler"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="24dp"/>

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese su nombre"
            android:inputType="textPersonName"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Apellido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apellido"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etApellido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese su apellido"
            android:inputType="textPersonName"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Forma de Pago -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forma de Pago"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etFormaPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Efectivo, Tarjeta de crédito"
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Cantidad de Días -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cantidad de Días"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etCantidadDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese la cantidad de días"
            android:inputType="number"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="32dp"/>

        <!-- Precio por día -->
        <TextView
            android:id="@+id/tvPrecioDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precio por día: $0"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>
        <TextView
            android:id="@+id/tvTotalCalculado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: $0 USD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="32dp"/>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar"
                android:backgroundTint="#B0BEC5"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Confirmar"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"/>

        </LinearLayout>


    </LinearLayout>
</ScrollView>